--- /dev/null
+++ b/src/engine/catj_reranker.h
@@ -0,0 +1,22 @@
+#ifndef MOZC_ENGINE_CATJ_RERANKER_H_
+#define MOZC_ENGINE_CATJ_RERANKER_H_
+
+#include <chrono>
+
+#include "absl/functional/function_ref.h"
+#include "catj/catj_context_model.h"
+#include "converter/segments.h"
+
+namespace mozc::engine {
+
+// Reorders at most one newly generated segment, before assigning list IDs.
+// Returns false without mutation if no eligible score beats both margins
+// or the operation runs out of time.
+bool TryRerankCatjConversion(
+    Segments& segments,
+    absl::FunctionRef<double(const catj::CandidateFeatures&)> score,
+    std::chrono::steady_clock::time_point deadline);
+
+}  // namespace mozc::engine
+
+#endif  // MOZC_ENGINE_CATJ_RERANKER_H_
diff --git a/src/engine/catj_reranker_test.cc b/src/engine/catj_reranker_test.cc
new file mode 100644
--- /dev/null
+++ b/src/engine/catj_reranker_test.cc
@@ -0,0 +1,140 @@
+#include "engine/catj_reranker.h"
+
+#include <chrono>
+#include <cstdint>
+#include <limits>
+#include <thread>
+
+#include "converter/attribute.h"
+#include "converter/segments.h"
+#include "testing/gunit.h"
+
+namespace mozc::engine {
+namespace {
+
+using ::mozc::converter::Attribute;
+using TimePoint = std::chrono::steady_clock::time_point;
+
+Segment& AddSegment(Segments& segments,
+                    Segment::SegmentType type = Segment::FREE) {
+  Segment* segment = segments.add_segment();
+  segment->set_key("reading");
+  segment->set_segment_type(type);
+  return *segment;
+}
+
+void AddCandidate(Segment& segment, const char* value,
+                  uint32_t attributes = Attribute::DEFAULT_ATTRIBUTE) {
+  auto* candidate = segment.add_candidate();
+  candidate->key = "reading";
+  candidate->value = value;
+  candidate->attributes = attributes;
+}
+
+TEST(CatjRerankerTest, PromotesLeftmostAndPreservesProtectedPositions) {
+  Segments segments;
+  Segment& fixed = AddSegment(segments, Segment::FIXED_VALUE);
+  AddCandidate(fixed, "fixed-first");
+  AddCandidate(fixed, "best");
+  Segment& left = AddSegment(segments);
+  AddCandidate(left, "base");
+  AddCandidate(left, "protected", Attribute::USER_DICTIONARY);
+  AddCandidate(left, "middle");
+  AddCandidate(left, "best");
+  Segment& right = AddSegment(segments);
+  AddCandidate(right, "base");
+  AddCandidate(right, "best");
+
+  EXPECT_TRUE(TryRerankCatjConversion(
+      segments, [](const catj::CandidateFeatures& candidate) {
+        EXPECT_NE(candidate.candidate_value, "protected");
+        return candidate.candidate_value == "best" ? 2.0 : 0.0;
+      },
+      TimePoint::max()));
+  EXPECT_EQ(fixed.candidate(0).value, "fixed-first");
+  EXPECT_EQ(left.candidate(0).value, "best");
+  EXPECT_EQ(left.candidate(1).value, "protected");
+  EXPECT_EQ(left.candidate(1).attributes, Attribute::USER_DICTIONARY);
+  EXPECT_EQ(left.candidate(2).value, "base");
+  EXPECT_EQ(left.candidate(3).value, "middle");
+  EXPECT_EQ(right.candidate(0).value, "base");
+}
+
+TEST(CatjRerankerTest, DoesNotReplaceACandidateAfterItsDeadline) {
+  Segments segments;
+  Segment& segment = AddSegment(segments);
+  AddCandidate(segment, "base");
+  AddCandidate(segment, "best");
+  const TimePoint deadline = std::chrono::steady_clock::now() +
+                             std::chrono::milliseconds(25);
+  EXPECT_FALSE(TryRerankCatjConversion(
+      segments, [&](const catj::CandidateFeatures& candidate) {
+        if (candidate.candidate_value == "base") return 0.0;
+        std::this_thread::sleep_until(deadline);
+        return 2.0;
+      }, deadline));
+  EXPECT_EQ(segment.candidate(0).value, "base");
+}
+
+TEST(CatjRerankerTest, NeverScoresPastEightNormalSlots) {
+  Segments segments;
+  Segment& segment = AddSegment(segments);
+  AddCandidate(segment, "base");
+  AddCandidate(segment, "protected", Attribute::COMMAND_CANDIDATE);
+  for (int i = 0; i < 7; ++i) AddCandidate(segment, "ordinary");
+  AddCandidate(segment, "ninth");
+  int scored = 0;
+  EXPECT_FALSE(TryRerankCatjConversion(
+      segments, [&](const catj::CandidateFeatures& candidate) {
+        ++scored;
+        EXPECT_NE(candidate.candidate_value, "ninth");
+        return 0.0;
+      }, TimePoint::max()));
+  EXPECT_EQ(scored, 8);
+  EXPECT_EQ(segment.candidate(0).value, "base");
+}
+
+TEST(CatjRerankerTest, KeepsCrossSegmentAndPartialCandidatesInTheirSlots) {
+  Segments segments;
+  Segment& segment = AddSegment(segments);
+  AddCandidate(segment, "base");
+  AddCandidate(segment, "cross-segment");
+  segment.mutable_candidate(1)->converted_segment_count = 2;
+  AddCandidate(segment, "partial", Attribute::PARTIALLY_KEY_CONSUMED);
+  AddCandidate(segment, "best");
+  AddCandidate(AddSegment(segments), "next");
+  EXPECT_TRUE(TryRerankCatjConversion(
+      segments, [](const catj::CandidateFeatures& candidate) {
+        EXPECT_NE(candidate.candidate_value, "cross-segment");
+        EXPECT_NE(candidate.candidate_value, "partial");
+        return candidate.candidate_value == "base" ? 0.0 : 2.0;
+      }, TimePoint::max()));
+  EXPECT_EQ(segment.candidate(0).value, "best");
+  EXPECT_EQ(segment.candidate(1).value, "cross-segment");
+  EXPECT_EQ(segment.candidate(2).value, "partial");
+  EXPECT_EQ(segment.candidate(3).value, "base");
+}
+
+TEST(CatjRerankerTest, RejectsInvalidScoresAndExpirations) {
+  Segments segments;
+  Segment& segment = AddSegment(segments);
+  AddCandidate(segment, "base");
+  AddCandidate(segment, "best");
+  EXPECT_FALSE(TryRerankCatjConversion(
+      segments, [](const catj::CandidateFeatures& candidate) {
+        return candidate.candidate_value == "base"
+                   ? std::numeric_limits<double>::quiet_NaN()
+                   : 1.0;
+      }, TimePoint::max()));
+  int scored = 0;
+  EXPECT_FALSE(TryRerankCatjConversion(
+      segments, [&](const catj::CandidateFeatures&) {
+        ++scored;
+        return 1.0;
+      }, TimePoint::min()));
+  EXPECT_EQ(scored, 0);
+  EXPECT_EQ(segment.candidate(0).value, "base");
+}
+
+}  // namespace
+}  // namespace mozc::engine
