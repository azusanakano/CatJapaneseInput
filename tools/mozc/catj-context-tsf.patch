+std::optional<CatjPrecedingText> TipSurroundingText::GetCatjPrecedingText(
+    TipTextService* text_service, ITfContext* context,
+    client::ClientInterface& client) {
+  if (!IsPackagedNotepad()) {
+    return std::nullopt;
+  }
+  HWND editor = GetCatjEditor();
+  if (!editor || !IsFocusedContext(text_service, context)) {
+    return std::nullopt;
+  }
+  auto full_context = TipTransitoryExtension::AsFullContext(context);
+  if (!full_context || !IsEditorContext(full_context.get(), editor)) {
+    return std::nullopt;
+  }
+  const auto reader = MakeComPtr<CatjPrecedingTextReader>(
+      text_service, context, full_context, editor);
+  config::Config config;
+  if (!reader || !client.GetConfig(&config) || config.incognito_mode() ||
+      !reader->StillFocused()) {
+    return std::nullopt;
+  }
+  // This request is made from the real Space key callback. When a read
+  // lock is unavailable, fall back immediately without queuing a stale read.
+  HRESULT session_result = E_FAIL;
+  const HRESULT hr = full_context->RequestEditSession(
+      text_service->GetClientID(), reader.get(), TF_ES_SYNC | TF_ES_READ,
+      &session_result);
+  if (hr != S_OK || session_result != S_OK || !reader->StillFocused()) {
+    return std::nullopt;
+  }
+  return reader->TakeText();
+}
+
+bool TipSurroundingTextUtil::CanReadCatjContext(
+    bool editor_verified, HRESULT scope_result,
+    std::span<const InputScope> scopes, InputScopeFailure failure,
+    bool tested_notepad_document) {
+  if (!editor_verified) {
+    return false;
+  }
+  if (failure == InputScopeFailure::kUnsupportedAppProperty) {
+    return scope_result == S_FALSE && scopes.empty();
+  }
+  if (failure == InputScopeFailure::kUnavailablePropertyValue) {
+    return tested_notepad_document && scope_result == E_FAIL && scopes.empty();
+  }
+  return scope_result == S_OK &&
+         std::all_of(scopes.begin(), scopes.end(),
+                     [](InputScope scope) { return scope == IS_DEFAULT; });
+}
