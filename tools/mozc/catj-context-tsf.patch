+TEST(TipSurroundingTextUtilTest, CatjGateRequiresTrustedEditorAndValidScope) {
+  constexpr InputScope kDefault[] = {IS_DEFAULT};
+  constexpr InputScope kPrivate[] = {IS_DEFAULT, IS_PRIVATE};
+  constexpr InputScope kPassword[] = {IS_DEFAULT, IS_PASSWORD};
+  constexpr InputScope kPin[] = {IS_NUMERIC_PIN};
+  constexpr InputScope kSearch[] = {IS_SEARCH};
+  EXPECT_TRUE(TipSurroundingTextUtil::CanReadCatjContext(true, S_OK, kDefault));
+  EXPECT_TRUE(TipSurroundingTextUtil::CanReadCatjContext(true, S_OK, {}));
+  EXPECT_FALSE(TipSurroundingTextUtil::CanReadCatjContext(false, S_OK, kDefault));
+  EXPECT_FALSE(TipSurroundingTextUtil::CanReadCatjContext(true, E_FAIL, {}));
+  EXPECT_FALSE(TipSurroundingTextUtil::CanReadCatjContext(true, S_OK, kPrivate));
+  EXPECT_FALSE(TipSurroundingTextUtil::CanReadCatjContext(true, S_OK, kPassword));
+  EXPECT_FALSE(TipSurroundingTextUtil::CanReadCatjContext(true, S_OK, kPin));
+  EXPECT_FALSE(TipSurroundingTextUtil::CanReadCatjContext(true, S_OK, kSearch));
+  constexpr auto kUnsupported = InputScopeFailure::kUnsupportedAppProperty;
+  EXPECT_TRUE(TipSurroundingTextUtil::CanReadCatjContext(true, S_FALSE, {}, kUnsupported));
+  EXPECT_FALSE(TipSurroundingTextUtil::CanReadCatjContext(false, S_FALSE, {}, kUnsupported));
+  EXPECT_FALSE(TipSurroundingTextUtil::CanReadCatjContext(true, S_FALSE, {}));
+  EXPECT_FALSE(TipSurroundingTextUtil::CanReadCatjContext(true, E_FAIL, {}, kUnsupported));
+  EXPECT_FALSE(TipSurroundingTextUtil::CanReadCatjContext(true, S_FALSE, kPrivate, kUnsupported));
+}
+
+TEST(TipSurroundingTextUtilTest, ScopeValueUnavailableRequiresVerifiedNotepadBody) {
+  constexpr auto kUnavailable = InputScopeFailure::kUnavailablePropertyValue;
+  constexpr InputScope kPrivate[] = {IS_PRIVATE};
+  EXPECT_TRUE(TipSurroundingTextUtil::CanReadCatjContext(true, E_FAIL, {}, kUnavailable, true));
+  EXPECT_FALSE(TipSurroundingTextUtil::CanReadCatjContext(true, E_FAIL, {}, kUnavailable, false));
+  EXPECT_FALSE(TipSurroundingTextUtil::CanReadCatjContext(false, E_FAIL, {}, kUnavailable, true));
+  EXPECT_FALSE(TipSurroundingTextUtil::CanReadCatjContext(true, S_FALSE, {}, kUnavailable, true));
+  EXPECT_FALSE(TipSurroundingTextUtil::CanReadCatjContext(true, E_FAIL, kPrivate, kUnavailable, true));
+  EXPECT_FALSE(TipSurroundingTextUtil::CanReadCatjContext(
+      true, E_FAIL, {}, InputScopeFailure::kNone, true));
+}
+
+TEST(TipSurroundingTextUtilTest, OnlyExplicitlyUnsupportedAppPropertyIsAbsent) {
+  EXPECT_TRUE(TipRangeUtil::IsUnsupportedAppProperty(S_FALSE, false));
+  EXPECT_FALSE(TipRangeUtil::IsUnsupportedAppProperty(S_FALSE, true));
+  EXPECT_FALSE(TipRangeUtil::IsUnsupportedAppProperty(S_OK, false));
+  EXPECT_FALSE(TipRangeUtil::IsUnsupportedAppProperty(E_FAIL, false));
+  EXPECT_TRUE(TipRangeUtil::IsUnavailableAppPropertyValue(E_FAIL, VT_EMPTY));
+  EXPECT_FALSE(TipRangeUtil::IsUnavailableAppPropertyValue(E_FAIL, VT_UNKNOWN));
+  EXPECT_FALSE(TipRangeUtil::IsUnavailableAppPropertyValue(S_FALSE, VT_EMPTY));
+  EXPECT_FALSE(TipRangeUtil::IsUnavailableAppPropertyValue(E_UNEXPECTED, VT_EMPTY));
+}
