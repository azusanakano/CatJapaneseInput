+  DWORD process = 0;
+  if (!editor || !host || !root || root != ::GetForegroundWindow() ||
+      ::GetWindowThreadProcessId(editor, &process) != ::GetCurrentThreadId() ||
+      process != ::GetCurrentProcessId() ||
